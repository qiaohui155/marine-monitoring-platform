# Confirmed from the QGIS ship_position layer information.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=Oman_Oil_Monitor
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_password
DB_SCHEMA=public

# Configure these locally with configure_shipxy.bat. Never commit the real key.
SHIPXY_API_KEY=replace_with_your_shipxy_api_key
SHIPXY_MMSI_LIST=357867000
SHIPXY_AUTO_START=false
SHIPXY_TARGET_DB=replace_with_your_live_ais_database
SHIPXY_POLL_SECONDS=15
SHIPXY_MAX_BACKOFF_SECONDS=300
SHIPXY_TRACK_MIN_SECONDS=60
SHIPXY_TRACK_MIN_METERS=20

# Simulated AIS movement for the local demonstration database. Vessels close
# to reviewed routes follow those routes; other vessels move locally around
# their existing sea positions. Set 5000 to include every current vessel.
# Do not enable this at the same time as live ShipXY collection.
SIMULATED_AIS_AUTO_START=false
SIMULATED_AIS_TARGET_DB=Oman_Oil_Monitor
SIMULATED_AIS_UPDATE_SECONDS=5
SIMULATED_AIS_MOVEMENT_SCALE=4.0
SIMULATED_TRACK_SECONDS=120
SIMULATED_TRACK_MIN_METERS=200
SIMULATED_AIS_MAX_VESSELS=5000
SIMULATED_AIS_MAX_JOIN_METERS=5000
